<?xml version="1.0" encoding="utf-8"?>
<!--
  应用级覆盖：react-native-exception-handler 自带的 default_error_screen 是英文白屏，
  用户完全看不懂发生了什么。这里用同名布局覆盖库内资源，换成中文说明 + 可复制的错误详情。

  注意：控件 id 必须与库里的 DefaultErrorScreen 保持一致，否则会 NullPointerException。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFDFB"
    android:orientation="vertical">

    <LinearLayout
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="72dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:paddingBottom="12dp"
            android:text="播放器遇到了一点问题" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#666666"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="28dp"
            android:text="很抱歉，应用刚刚发生了异常，已经停止当前操作。\n你可以直接重启应用继续听歌，错误详情已记录在「设置 - 其他 - 错误日志」中。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/eh_restart_button"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginRight="8dp"
                android:layout_height="46dp"
                android:background="#FF4E6E"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:text="重启应用" />

            <Button
                android:id="@+id/eh_quit_button"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_marginLeft="8dp"
                android:layout_height="46dp"
                android:background="#F0F0F0"
                android:textColor="#333333"
                android:textSize="15sp"
                android:text="退出" />
        </LinearLayout>

        <Button
            android:id="@+id/eh_show_details_button"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="查看错误详情"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:textColor="#FF4E6E"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/eh_stack_trace_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:textColor="#444444"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:text=""
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
